NODE_ENV=development
PORT=4000
API_PREFIX=api
API_VERSION=1
CORS_ORIGIN=http://localhost:3000
SWAGGER_ENABLED=true
FRONTEND_URL=http://localhost:3000

# Replace these in every shared or production environment.
JWT_SECRET=local-only-change-this-jwt-secret-123456
NIN_HASH_SECRET=local-only-change-this-nin-secret-123456
COOKIE_SECURE=false
COOKIE_SAME_SITE=lax

# Local development uses SQL.js. Set DATABASE_URL for PostgreSQL deployments.
SQLITE_PATH=data/skifa.sqlite
# DATABASE_URL=postgresql://user:password@host:5432/skifa
DB_SSL=false
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false

# Private local upload storage. Production needs a persistent private disk.
UPLOAD_DIR=uploads

# Mock mode grants entitlements only outside production.
PAYMENTS_MODE=mock

# Use EMAIL_MODE=smtp and fill these values for real delivery.
EMAIL_MODE=log
# SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
SMTP_FROM=Skifa <no-reply@skifa.local>

# Optional bootstrap administrator for verification reviews.
# ADMIN_EMAIL=admin@skifa.example
# ADMIN_PASSWORD=replace-with-at-least-12-characters
